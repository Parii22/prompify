# ==========================================
# Server Environment Configuration
# ==========================================

# Port and Environment (Default 5001 avoids macOS AirPlay ControlCenter clash on 5000)
PORT=5001
NODE_ENV=development

# Allowed Client Origin (for CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# Primary LLM Provider: Google Gemini API
# ==========================================

# Your Google Gemini API Key from Google AI Studio (Required)
GEMINI_API_KEY=

# Gemini Model Name (e.g. gemini-3.5-flash-lite, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# Secondary / Fallback LLM Provider: Groq Cloud
# ==========================================

# Your Groq Cloud API Key from console.groq.com (Required for automatic fallback)
GROQ_API_KEY=

# Supported Groq Model ID (e.g. openai/gpt-oss-120b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================
# Supabase PostgreSQL Integration
# ==========================================

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Service Role Secret Key (Required for backend authorized database operations)
# CAUTION: Never expose this key to client code or version control!
SUPABASE_SERVICE_ROLE_KEY=
